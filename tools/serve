#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
shared="${FAKE_GIT_HOST_SOURCE:-$(cd "$repo/../fake-git-host" && pwd)}"
ha_config="${HA_CONFIG:-/Volumes/config}"
PYTHONPATH="$shared${PYTHONPATH:+:$PYTHONPATH}" exec "$repo/.venv/bin/python" -m fake_git_host "$repo" --port "${HA_DIAL_GIT_PORT:-9421}" \
  --after-snapshot "$repo/.venv/bin/python" "$repo/tools/deploy.py" "$ha_config"
