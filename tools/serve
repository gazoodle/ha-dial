#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
shared="${FAKE_GIT_HOST_SOURCE:-$(cd "$repo/../fake-git-host" && pwd)}"
ha_config="${HA_CONFIG:-/Volumes/config}"
PYTHONPATH="$shared${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m fake_git_host "$repo" \
  --after-snapshot python3 "$repo/tools/deploy.py" "$ha_config"
